{
  "name": "@deepseek-ai/dsh-office-to-pdf",
  "description": "Shared Office-to-PDF conversion with bounded queues and caching",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/document/office-to-pdf"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/cordis-plugin-include": "^1.0.7",
    "@deepseek-ai/dsh-api-workspace-files": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.6-alpha.2"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-brand": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.6-alpha.2",
    "@dsh-sep/office-converter": "0.1.0"
  },
  "dshSepOfficeAdapter": {
    "revision": "20260921-office-r2",
    "fontDiagnostics": "unavailable"
  }
}
